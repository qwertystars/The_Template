# API Configuration
# Leave empty to use same origin (Nginx will proxy /api to backend)
VITE_API_URL=
VITE_API_TIMEOUT=30000

# Application
VITE_APP_NAME="Full Stack Template"
VITE_APP_VERSION="1.0.0"

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_WEBSOCKET=true

# OAuth (if needed on frontend)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Environment
VITE_ENVIRONMENT=development
